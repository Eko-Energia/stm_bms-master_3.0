*.dwo

# Claude Code local settings
/.claude/settings.local.json

# Superpowers docs
/docs/superpowers/

# Superpowers subagent-driven-development scratch (briefs, diffs, progress ledger)
/.superpowers/

# Agent scratch, kept local by design: implementation plans for one ticket and
# CodeRabbit triage tables for one PR round. The durable record of a decision
# belongs in Linear and in docs/adr/, not in a plan file.
/.claude/plans/
/.claude/reviews/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
# stm32-mcp server environment (the checkout itself is a submodule, see docs/stm32Mcp.md)
/.claude/mcp/.venv/

# cantools fork + its uv environment, bootstrapped on demand (see docs/canDatabase.md).
# Deliberately not a submodule: it is a build-time tool, not a project dependency.
/.claude/tmp/

# STM32CubeIDE macOS project artefact
/.osx.project

# Oracle intermediate: written by test_pack_vectors, consumed by check_packing.py
tests/oracle/vectors.txt

# Stress-harness build output. The harnesses themselves are committed: they
# found the CAN mailbox starvation, the node-frame starvation and the JK value
# gaps, none of which the unit suite could reach.
tests/stress/build/
tests/stress/*.o
tests/stress/*.out
tests/stress/*.bin
tests/stress/*.log
tests/stress/**/*.dSYM/
